# LLM CONFIGURATION
LLM_API_KEY=sk-...
LLM_BASE_URL=https://llm-proxy.prod.outshift.ai
LLM_MODEL=bedrock/global.anthropic.claude-sonnet-4-6

# RUN CONFIGURATION
DATASET_PATH=path/to/dataset     # (.zip, dir, or file) — required
SPEC_PATH=path/to/source_or_docs # (.zip, dir, or file) — required
USER_PROMPT=                     # optional: User (input) Prompt for the specific run

# ADVANCED (uncomment to override defaults)
# MAX_ITERATIONS=20
# MAX_DEPTH=1
# CONTEXT_TOKEN_LIMIT=200000
# LOG_DIR=results
